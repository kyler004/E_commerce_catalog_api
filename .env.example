# PostgreSQL connection settings
POSTGRES_DB=ecommerce_catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# SMTP (OTP emails)
