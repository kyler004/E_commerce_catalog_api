# Local PostgreSQL (Docker Compose)
POSTGRES_DB=ecommerce_catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Render / production database (takes precedence when set)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# Comma-separated hostnames (required in production)
# ALLOWED_HOSTS=your-api.onrender.com,localhost,127.0.0.1

# Comma-separated frontend origins (defaults to http://localhost:5173 when unset)
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:5173

# Comma-separated HTTPS origins for CSRF (include API + frontend in production)
# CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com,https://your-frontend.com

# Production security (applied when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# SMTP (OTP emails)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@example.com
